# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (MongoDB Atlas connection string, or 'memory' for in-memory testing)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ecommerce?retryWrites=true&w=majority

# Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_12345
JWT_EXPIRE=30d

# Payments (Stripe Test Mode Secret Key - sk_test_...)
STRIPE_SECRET_KEY=sk_test_placeholder

# Image Hosting (Cloudinary - Free tier)
CLOUDINARY_CLOUD_NAME=placeholder
CLOUDINARY_API_KEY=placeholder
CLOUDINARY_API_SECRET=placeholder
